    {
      "name": "business",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"business\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"price_cents\" INTEGER NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"tax_percent\" INTEGER NOT NULL, \"deposit_cents\" INTEGER NOT NULL DEFAULT 0, \"tags\" TEXT NOT NULL DEFAULT '', \"info\" TEXT NULL, \"template_id\" TEXT NULL, \"favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favorite\" IN (0, 1)), \"in_sale\" INTEGER NOT NULL DEFAULT 1 CHECK (\"in_sale\" IN (0, 1)), \"photo_path\" TEXT NULL, \"position\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "modifier_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"modifier_templates\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "modifier_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"modifier_groups\" (\"id\" TEXT NOT NULL, \"template_id\" TEXT NOT NULL REFERENCES modifier_templates (id), \"name\" TEXT NOT NULL, \"min_count\" INTEGER NOT NULL, \"max_count\" INTEGER NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "modifier_options",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"modifier_options\" (\"id\" TEXT NOT NULL, \"group_id\" TEXT NOT NULL REFERENCES modifier_groups (id), \"name\" TEXT NOT NULL, \"surcharge_cents\" INTEGER NOT NULL DEFAULT 0, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"tax_percent\" INTEGER NULL, \"deposit_cents\" INTEGER NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "staff",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"staff\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"pin_salt\" TEXT NOT NULL, \"pin_hash\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL, \"cash_drawer_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"cash_drawer_enabled\" IN (0, 1)), \"show_images\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_images\" IN (0, 1)), \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"void_requires_chef\" INTEGER NOT NULL DEFAULT 0 CHECK (\"void_requires_chef\" IN (0, 1)), \"receipt_draft\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "business_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"business_days\" (\"id\" TEXT NOT NULL, \"opened_at\" INTEGER NOT NULL, \"closed_at\" INTEGER NULL, \"opening_float_cents\" INTEGER NULL, \"counted_cents\" INTEGER NULL, \"left_in_drawer_cents\" INTEGER NULL, \"expected_cents\" INTEGER NULL, \"difference_cents\" INTEGER NULL, \"closed_by_name\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cash_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cash_movements\" (\"id\" TEXT NOT NULL, \"business_day_id\" TEXT NOT NULL REFERENCES business_days (id), \"kind\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"staff_id\" TEXT NOT NULL, \"staff_name\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipts\" (\"id\" TEXT NOT NULL, \"number\" INTEGER NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, \"staff_id\" TEXT NOT NULL, \"staff_name\" TEXT NOT NULL, \"business_day_id\" TEXT NOT NULL REFERENCES business_days (id), \"kind\" TEXT NOT NULL, \"voids_receipt_id\" TEXT NULL REFERENCES receipts (id), \"goods_cents\" INTEGER NOT NULL, \"deposit_cents\" INTEGER NOT NULL, \"total_cents\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "receipt_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receipt_lines\" (\"receipt_id\" TEXT NOT NULL REFERENCES receipts (id), \"position\" INTEGER NOT NULL, \"item_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"info\" TEXT NULL, \"unit_price_cents\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL, \"unit_deposit_cents\" INTEGER NOT NULL, \"gross20_cents\" INTEGER NOT NULL DEFAULT 0, \"gross10_cents\" INTEGER NOT NULL DEFAULT 0, \"gross13_cents\" INTEGER NOT NULL DEFAULT 0, \"gross0_cents\" INTEGER NOT NULL DEFAULT 0, \"gross19_cents\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"receipt_id\", \"position\"));"
